{
  "name": "@dmaximyuk/signature",
  "version": "1.0.15",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmaximyuk/signature.git"
  },
  "main": "./dist/index.js",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^24.3.0",
    "prettier": "^3.6.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bugs": {
    "url": "https://github.com/dmaximyuk/signature/issues"
  },
  "description": "Quick signature for Telegram and VKontakte",
  "homepage": "https://github.com/dmaximyuk/signature#readme",
  "keywords": [
    "vk",
    "vkontakte",
    "tg",
    "telegram",
    "sign",
    "signature",
    "auth",
    "init",
    "start",
    "crypto"
  ],
  "license": "MIT",
  "private": false,
  "scripts": {
    "dev": "bun run ./index.ts",
    "build": "sh -c 'rm -rf dist && node node_modules/typescript/bin/tsc -p tsconfig.json && node node_modules/typescript/bin/tsc --emitDeclarationOnly -p tsconfig.types.json'",
    "build:declaration": "node node_modules/typescript/bin/tsc --emitDeclarationOnly --project tsconfig.types.json",
    "test": "bun test"
  },
  "type": "module",
  "types": "./dist/index.d.ts"
}
